# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox). Sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Set after `npm run webhook:register` against a public URL
PAYPAL_WEBHOOK_ID=
# US sandbox personal account that receives creator payouts in demo rooms
PAYPAL_CREATOR_PAYEE_EMAIL=

# Optional. Without it the app runs in manual-confirm mode (the same span guard, no LLM).
ANTHROPIC_API_KEY=

# Optional. Without it the app uses in-process PGlite at .data/pglite
DATABASE_URL=

PUBLIC_BASE_URL=http://localhost:8790
PORT=8790
# Code in the Devpost testing instructions; unlocks the judge budget pool
JUDGE_CODE=
DETECT_TAU=0.80
JUDGE_DAILY_MICROS=5000000
PUBLIC_DAILY_MICROS=2000000
ROOM_CAP_MICROS=750000
# Public-pool rooms one IP may open per day (default 20; judge-code rooms are not limited). Judging window: 60.
ROOMS_PER_IP_PER_DAY=
# Optional: PGlite data folder when DATABASE_URL is unset (default .data/pglite)
PGLITE_DIR=
# Optional: minutes between in-server synthetic runs (judge path end to end, real sandbox + Claude, about $0.04
# each). Empty or 0 = off, the local default; the hosted deploy uses 60 (render.yaml). Minimum 5.
SYNTHETIC_EVERY_MIN=
